{
  "name": "sasta-dawa-finder",
  "version": "2.1.0",
  "description": "Official DRAP medicine prices for Pakistan and cheaper brands with the exact same formula",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "build": "node scripts/build_public.js",
    "test": "node --test tests/*.test.js",
    "sync-data": "node scripts/sync_drap.js",
    "build-data": "node scripts/sync_drap.js --build-only",
    "sitemap": "node scripts/generate_sitemap.js",
    "build:app": "node scripts/build_app.js",
    "app:sync": "node scripts/build_app.js && npx cap sync",
    "app:android": "npm run app:sync && npx cap open android",
    "app:ios": "npm run app:sync && npx cap open ios"
  },
  "keywords": [
    "medicine",
    "pakistan",
    "generic-alternatives",
    "pharmacy",
    "dawa"
  ],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "@capacitor/android": "^8.6.2",
    "@capacitor/cli": "^8.6.2",
    "@capacitor/ios": "^8.6.2",
    "jsdom": "^29.1.1"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.7.0",
    "@capacitor/app": "^8.1.2",
    "@capacitor/browser": "^8.0.5",
    "@capacitor/core": "^8.6.2",
    "@capacitor/local-notifications": "^8.3.1",
    "@capacitor/share": "^8.0.3",
    "@capacitor/splash-screen": "^8.0.2",
    "@capacitor/status-bar": "^8.0.4",
    "@vercel/blob": "2.8.2"
  },
  "engines": {
    "node": ">=20"
  },
  "overrides": {
    "zod": "4.6.7"
  }
}
